# Python packages in the agent image, adapted from IHS DataLab's
# images/agent/requirements.in at 6b6fdca (same packages).
# Pinned versions, with hashes, are in requirements.txt (the Dockerfile
# installs it with --require-hashes). From the repository root:
#   uv pip compile images/agent/requirements.in --universal --python-version 3.12 \
#     --generate-hashes -o images/agent/requirements.txt
# The existing pins are kept as preferences; add --upgrade-package to move one.
altair
duckdb
matplotlib
numpy
openpyxl
pandas
pdfplumber
plotly
plotnine
polars
pyarrow
pypdf
python-docx
python-pptx
scikit-learn
scipy
seaborn
statsmodels
tabulate
vl-convert-python
xlrd
xlsxwriter
# Figures
colorcet
scienceplots
# Web and general scripting
beautifulsoup4
httpx
lxml
requests
pytest
ruff

# Reproducible environments, notebooks and dashboards. Notebooks: the
# kernel and headless execution only (Quarto and `jupyter nbconvert` use
# these); no Jupyter server, JupyterLab or Notebook.
